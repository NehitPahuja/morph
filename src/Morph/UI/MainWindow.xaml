<Window x:Class="Morph.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morph" Width="940" Height="620" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Left rail: the queue ============ -->
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20,14,16">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="/Assets/Morph.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Morph" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Converts on this PC. Nothing is uploaded." FontSize="11" Foreground="{StaticResource Dim}" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Explorer menu switch -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="4,14,0,0" Margin="0,10,0,0">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MenuEnabled}"
                              Content="Show in Explorer's right-click menu"
                              ToolTip="Adds “Convert with Morph” to the menu of every file Morph can open. On Windows 11 it's under “Show more options”." />
                </Border>

                <!-- Queue header -->
                <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                    <TextBlock Text="{Binding QueueTitle}" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Command="{Binding BrowseCommand}" ToolTip="Add files">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ClearCommand}" ToolTip="Clear the list"
                                Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Queue -->
                <Grid>
                    <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Files}" ItemContainerStyle="{StaticResource RowItem}"
                             Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Width="34" Height="34" CornerRadius="9" Background="{StaticResource Card}" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Foreground="{StaticResource Sub}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" ToolTip="{Binding Detail}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Margin="10,6,6,0" Height="3" Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                    <Grid Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="14"
                                                   Visibility="{Binding HasStateGlyph, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Removable, Converter={StaticResource Vis}}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty queue -->
                    <TextBlock Text="Files you add show up here." Foreground="{StaticResource Dim}" FontSize="12" Margin="4,6,0,0"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Right side ============ -->
        <Grid Grid.Column="1">

            <!-- Empty: big drop target -->
            <Grid Margin="36" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                <Rectangle RadiusX="22" RadiusY="22" Stroke="{StaticResource Line}" StrokeThickness="2" StrokeDashArray="5 4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AccentWash}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" FontSize="30" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="Drop files to convert" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,6" />
                    <TextBlock Text="Audio, video, images and PDFs. Everything stays on your PC." Foreground="{StaticResource Sub}"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding BrowseCommand}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Choose files" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="or right-click files in Explorer → Convert with Morph" Foreground="{StaticResource Dim}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>

            <!-- Picking a format -->
            <Grid Margin="36,30,28,24" Visibility="{Binding ShowPicker, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />

                <ListBox Grid.Row="1" Style="{StaticResource BareList}" Margin="0,16,0,0" ItemContainerStyle="{StaticResource PillItem}"
                         ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Visibility="{Binding ShowCategories, Converter={StaticResource Vis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource BadWash}"
                        Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Bad}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Format tiles -->
                <ListBox Grid.Row="3" Style="{StaticResource BareList}" Margin="0,20,0,0"
                         ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TileItem}">
                            <Setter Property="IsEnabled" Value="{Binding Available}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Top" />
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Blurb}" FontSize="11" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Options -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="QUALITY" Style="{StaticResource Caps}" />
                        <Border Background="{StaticResource Card}" CornerRadius="11" HorizontalAlignment="Left">
                            <ListBox Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource SegmentItem}"
                                     ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>
                        <TextBlock Text="{Binding QualityHint}" FontSize="11" Foreground="{StaticResource Dim}" Margin="2,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SAVE TO" Style="{StaticResource Caps}" />
                        <Border Background="{StaticResource Card}" CornerRadius="11" HorizontalAlignment="Left">
                            <ListBox Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource SegmentItem}"
                                     ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" DisplayMemberPath="Label"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>
                        <DockPanel Margin="2,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Change…" Margin="8,0,0,0"
                                    Command="{Binding PickFolderCommand}" />
                            <TextBlock Text="{Binding FolderText}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FolderText}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <DockPanel Grid.Row="5" Margin="0,22,0,0" LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding OpenWhenDone}"
                              Content="Open the folder when finished" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding ConvertCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConvertLabel}" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" Margin="10,1,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SkippedText}" Foreground="{StaticResource Dim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                </DockPanel>
            </Grid>

            <!-- Running -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380"
                        Visibility="{Binding ShowRunning, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Percent}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Light"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Counter}" Style="{StaticResource Caps}" HorizontalAlignment="Center" Margin="0,2,0,6" />
                <TextBlock Text="{Binding CurrentName}" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Value="{Binding Overall, Mode=OneWay}" Height="6" Margin="0,22,0,26" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Content="Stop" />
            </StackPanel>

            <!-- Finished -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding ShowFinished, Converter={StaticResource Vis}}">
                <Grid HorizontalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38" Background="#2243D69B"
                            Visibility="{Binding AllGood, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="30" Foreground="{StaticResource Good}" />
                    </Border>
                    <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource BadWash}"
                            Visibility="{Binding SomeFailed, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="30" Foreground="{StaticResource Bad}" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{Binding SummaryDetail}" Foreground="{StaticResource Sub}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"
                            Visibility="{Binding HasOutputs, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Show in folder" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AgainCommand}" Content="Convert again" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding NewBatchCommand}" Content="New batch" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
